[Unit]
Description=Casa Search FastAPI Backend
After=network.target

[Service]
Type=simple
User=hermes
WorkingDirectory=/home/hermes/mudanza-casa-app/backend
Environment="PATH=/home/hermes/mudanza-casa-app/backend/.venv/bin"
ExecStart=/home/hermes/mudanza-casa-app/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target